---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HostRig from '../components/HostRig.astro';
import VideoCard from '../components/VideoCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { watchHref, durationLabel, posterOf, timeAgo, displayCategory } from '../lib/video';

const videos = (await getCollection('videos', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.pubDate - +a.data.pubDate
);

// 홈 히어로 = 로지가 서 있는 스튜디오 + 최신 영상 썸네일 목록.
// 예전엔 최신 한 편을 자동재생했고, 그 다음엔 추천작을 훑는 리엘을 틀었다. 둘 다 "보고 있어야
// 다음 정보가 나오는" 구조라, 처음 온 방문자가 어떤 편들이 있는지 한눈에 못 봤다.
// 지금은 재생을 기다릴 필요 없이 목록이 즉시 다 보이고, 썸네일을 누르면 그 편으로 바로 간다.
const PICK_MAX = 6;
const curated = videos
  .filter((v) => typeof v.data.pick === 'number')
  .sort((a, b) => (a.data.pick as number) - (b.data.pick as number));
// 기본은 최신순. pick을 지정한 글이 있으면 그 순서가 우선한다(큐레이션 훅).
const picks = (curated.length ? curated : videos).slice(0, PICK_MAX);

// 카드 라벨 — 우선순위는 frontmatter `hook`(후킹 한 줄)이고, 없을 때만 아래 제목 축약을 쓴다.
// 제목을 줄인 라벨은 "무슨 게임인지"만 알려줄 뿐 왜 봐야 하는지는 말해주지 않아 클릭이 잘 안 붙는다.
// 축약 규칙: ①"게임명 — 설명" 규격이면 앞부분 ②그래도 길면 따옴표로 감싼 고유명 ③최후에 절단.
const MAX_LABEL = 24;
const QUOTE_PAIRS: Record<string, string> = { "'": "'", '"': '"', '「': '」', '『': '』', '‘': '’', '“': '”' };
function cardTitle(t: string): string {
  let head = t.split(/\s[—–]\s/)[0].trim();
  const q = t.match(/['"「『‘“]([^'"」』’”]{2,22})['"」』’”]/);
  if (head.length > MAX_LABEL) {
    if (q && q[1].length <= MAX_LABEL) head = q[1];
    else head = head.split(/[!?·,]/)[0].trim();
  }
  const close = QUOTE_PAIRS[head[0]];
  if (close && head.endsWith(close) && head.length > 2) head = head.slice(1, -1).trim();
  return head.length > MAX_LABEL ? head.slice(0, MAX_LABEL - 1).trimEnd() + '…' : head;
}

// 필터칩·grid-item 의 카테고리는 카드에 '보이는' 라벨과 같아야 한다(New 시효 반영).
// 안 맞추면 "New" 칩이 반년 전 편까지 24개를 물어오는데 카드 태그는 New 가 아니어서 어긋난다.
// 순서: New 를 맨 앞에 두고 나머지는 등장순.
const shownCatOf = (v: (typeof videos)[number]) => displayCategory(v.data.category, v.data.pubDate);
const cats = Array.from(new Set(videos.map(shownCatOf))).sort((a, b) =>
  a === 'New' ? -1 : b === 'New' ? 1 : 0
);

// 채널 홈 = 영상 목록. ItemList로 검색엔진에 콘텐츠 리스트 구조 전달
const site = Astro.site || new URL('https://virtual-in-playing.vercel.app');
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '추천 게임 소개 영상',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: picks.length,
  itemListElement: picks.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(watchHref(v.id), site).href,
    name: v.data.title,
  })),
};
---

<BaseLayout
  title="Virtual in Playing (VIP) — 게임 소개 방송 채널"
  description="버츄얼 호스트 로지가 게임·최신 신작·버추얼 아이돌/스트리머를 영상처럼 소개하는 채널. 무료 게임·인디 명작부터 버튜버 입문까지, 자막 영상으로 편하게."
  schemas={[itemListSchema]}
>
  {
    picks.length > 0 && (
      <section class="pc-studio">
        <div class="studio-head">
          <div class="hero-kicker">▶ 로지의 추천</div>
          <h2 class="studio-title">지금 볼 만한 영상</h2>
          <p class="studio-sub">카드를 누르면 바로 시청 페이지로 이동합니다.</p>
        </div>

        <div class="studio-stage">
          <div class="studio-rig" aria-hidden="true">
            <HostRig />
          </div>

          <ul class="float-cards">
            {picks.map((v, i) => {
              const poster = posterOf(v.data);
              return (
                <li class="fc-item" style={`--i:${i}`}>
                  <a href={watchHref(v.id)} class="fc-card">
                    <span class="fc-thumb">
                      {poster && <img src={poster} alt="" loading="lazy" />}
                      <span class="fc-dur">
                        {durationLabel(v.data.scenes, v.data.durationLabel)}
                      </span>
                    </span>
                    <span class="fc-body">
                      <span class="fc-title">{v.data.hook || cardTitle(v.data.title)}</span>
                      <span class="fc-meta">
                        {v.data.category} · {timeAgo(v.data.pubDate)}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 추천 스튜디오와 전체 목록 사이 — 스크롤로 지나가는 자리라 300x250(PC·모바일 겸용) -->
  <AdSlot position="home" />

  <div class="section-title"><span class="bar"></span> 전체 영상</div>

  {/* 좌: 카테고리 칩(가로 스크롤) / 우: 보기 방식 토글. 칩 줄에 같이 넣으면 토글이 함께
      스크롤돼 사라지므로, 한 단계 감싸서 토글만 고정한다. */}
  <div class="pc-listbar">
    <div class="pc-chips" id="pc-chips">
      <button class="pc-chip is-active" data-cat="__all">전체</button>
      {cats.map((c) => <button class="pc-chip" data-cat={c}>{c}</button>)}
    </div>
    <div class="pc-view" id="pc-view" role="group" aria-label="목록 보기 방식">
      <button class="pc-viewbtn is-active" data-view="card" aria-pressed="true" title="카드 보기" aria-label="카드 보기">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
          <rect x="3" y="4" width="8" height="7" rx="1.5" /><rect x="13" y="4" width="8" height="7" rx="1.5" />
          <rect x="3" y="13" width="8" height="7" rx="1.5" /><rect x="13" y="13" width="8" height="7" rx="1.5" />
        </svg>
      </button>
      <button class="pc-viewbtn" data-view="list" aria-pressed="false" title="리스트 보기" aria-label="리스트 보기">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
          <rect x="3" y="5" width="7" height="5" rx="1.2" /><rect x="12" y="5.6" width="9" height="1.8" rx="0.9" />
          <rect x="12" y="8.6" width="6" height="1.6" rx="0.8" />
          <rect x="3" y="14" width="7" height="5" rx="1.2" /><rect x="12" y="14.6" width="9" height="1.8" rx="0.9" />
          <rect x="12" y="17.6" width="6" height="1.6" rx="0.8" />
        </svg>
      </button>
    </div>
  </div>

  <div class="pc-grid" id="pc-grid">
    {
      videos.map((v) => (
        <div class="grid-item" data-cat={shownCatOf(v)} data-title={v.data.title.toLowerCase()}>
          <VideoCard video={v} />
        </div>
      ))
    }
  </div>

  <p id="pc-empty" style="display:none;text-align:center;color:var(--text-muted);padding:3rem">
    검색 결과가 없어요.
  </p>

  <script is:inline slot="tail">
    (function () {
      var chips = document.getElementById('pc-chips');
      var grid = document.getElementById('pc-grid');
      var empty = document.getElementById('pc-empty');
      var search = document.getElementById('pc-search-input');
      var cat = '__all';
      var q = '';
      function apply() {
        var shown = 0;
        grid.querySelectorAll('.grid-item').forEach(function (el) {
          var okCat = cat === '__all' || el.dataset.cat === cat;
          var okQ = !q || el.dataset.title.indexOf(q) !== -1;
          var vis = okCat && okQ;
          el.style.display = vis ? '' : 'none';
          if (vis) shown++;
        });
        empty.style.display = shown ? 'none' : 'block';
      }
      if (chips)
        chips.addEventListener('click', function (e) {
          var b = e.target.closest('.pc-chip');
          if (!b) return;
          chips.querySelectorAll('.pc-chip').forEach(function (c) {
            c.classList.remove('is-active');
          });
          b.classList.add('is-active');
          cat = b.dataset.cat;
          apply();
        });
      if (search)
        search.addEventListener('input', function () {
          q = search.value.trim().toLowerCase();
          apply();
        });

      // 보기 방식(카드/리스트) 토글 — 선택은 localStorage 에 남겨 다음 방문에도 유지한다.
      var view = document.getElementById('pc-view');
      var KEY = 'pc-view';
      function setView(mode) {
        grid.classList.toggle('is-list', mode === 'list');
        if (view)
          view.querySelectorAll('.pc-viewbtn').forEach(function (b) {
            var on = b.dataset.view === mode;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
        try {
          localStorage.setItem(KEY, mode);
        } catch (e) {}
      }
      try {
        var saved = localStorage.getItem(KEY);
        if (saved === 'list') setView('list');
      } catch (e) {}
      if (view)
        view.addEventListener('click', function (e) {
          var b = e.target.closest('.pc-viewbtn');
          if (b) setView(b.dataset.view);
        });
    })();
  </script>
</BaseLayout>
