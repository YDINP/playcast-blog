---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HostStage from '../components/HostStage.astro';
import VideoCard from '../components/VideoCard.astro';
import { watchHref, durationLabel, posterOf } from '../lib/video';

const videos = (await getCollection('videos', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.pubDate - +a.data.pubDate
);

// 홈 히어로 = "최신 한 편 자동재생"이 아니라 추천 영상들을 훑어주는 소개 리엘.
// 최신 글이 그날의 대표작이라는 보장이 없고, 방문자가 처음 보는 화면이 한 편에 묶이면
// 나머지 영상으로 가는 길이 그리드 스크롤뿐이었다. 추천 목록 자체를 영상으로 만든다.
const PICK_MAX = 5;
const curated = videos
  .filter((v) => typeof v.data.pick === 'number')
  .sort((a, b) => (a.data.pick as number) - (b.data.pick as number));
// 큐레이션이 없으면 조회수 → 최신 순으로 자동 선정(홈이 비지 않게).
const picks = (curated.length
  ? curated
  : [...videos].sort((a, b) => (b.data.views || 0) - (a.data.views || 0) || +b.data.pubDate - +a.data.pubDate)
).slice(0, PICK_MAX);

// 제목이 "게임명 — 설명" 규격이라 앞부분만 쓰면 자막이 깔끔하다.
// 따옴표는 양끝을 함께 감쌀 때만 벗긴다 — 한쪽만 지우면 "스팀 대박난 '메챠 카멜레온" 처럼 짝이 깨진다.
const QUOTE_PAIRS: Record<string, string> = { "'": "'", '"': '"', '「': '」', '『': '』', '‘': '’', '“': '”' };
const shortTitle = (t: string) => {
  const head = t.split(/\s[—–-]\s/)[0].trim();
  const close = QUOTE_PAIRS[head[0]];
  return close && head.endsWith(close) && head.length > 2 ? head.slice(1, -1).trim() : head;
};
// 설명 첫 문장만(자막 한 줄 분량).
const firstSentence = (s: string) => {
  const m = s.split(/(?<=[.!?])\s|(?<=[다요])\s/)[0] || s;
  return m.length > 78 ? m.slice(0, 76).trimEnd() + '…' : m;
};

const reelScenes = picks.length
  ? [
      {
        text: '안녕하세요, 로지예요! 오늘은 VIP가 골라둔 **추천 영상**들을 한 번에 훑어드릴게요.',
        image: posterOf(picks[0].data),
        emotion: 'happy' as const,
        chapter: '오프닝',
      },
      ...picks.map((v, i) => ({
        text: `${i + 1}. **${shortTitle(v.data.title)}** — ${firstSentence(v.data.description)}`,
        image: posterOf(v.data),
        emotion: (i % 2 === 0 ? 'happy' : 'surprised') as 'happy' | 'surprised',
        chapter: `추천 ${i + 1}`,
      })),
      {
        text: '마음에 드는 편이 있었나요? 바로 아래 목록에서 골라 보시면 됩니다!',
        image: posterOf(picks[picks.length - 1].data),
        emotion: 'happy' as const,
        chapter: '마무리',
      },
    ]
  : [];

const cats = Array.from(new Set(videos.map((v) => v.data.category)));

// 채널 홈 = 영상 목록. ItemList로 검색엔진에 콘텐츠 리스트 구조 전달
const site = Astro.site || new URL('https://virtual-in-playing.vercel.app');
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '추천 게임 소개 영상',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: picks.length,
  itemListElement: picks.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(watchHref(v.id), site).href,
    name: v.data.title,
  })),
};
---

<BaseLayout
  title="Virtual in Playing (VIP) — 게임 소개 방송 채널"
  description="버츄얼 호스트 로지가 게임·최신 신작·버추얼 아이돌/스트리머를 영상처럼 소개하는 채널. 무료 게임·인디 명작부터 버튜버 입문까지, 자막 영상으로 편하게."
  schemas={[itemListSchema]}
>
  {
    reelScenes.length > 0 && (
      <section class="pc-hero">
        <HostStage scenes={reelScenes} playerId="heroreel" host="rosie" />
        <div class="hero-info">
          <div class="hero-copy">
            <div class="hero-kicker">▶ 추천 영상 모아보기</div>
            <h2>로지가 고른 {picks.length}편</h2>
            <p>
              지금 볼 만한 편들을 한 영상으로 소개합니다. 아래 목록에서 원하는 편을 바로 시청하세요.
            </p>
          </div>
        </div>

        <ol class="pc-picks">
          {picks.map((v, i) => {
            const poster = posterOf(v.data);
            return (
              <li class="pick-item">
                <a href={watchHref(v.id)} class="pick-link">
                  <span class="pick-rank">{i + 1}</span>
                  <span class="pick-thumb">
                    {poster && <img src={poster} alt="" loading="lazy" />}
                  </span>
                  <span class="pick-body">
                    <span class="pick-title">{v.data.title}</span>
                    <span class="pick-meta">
                      {v.data.category} · {durationLabel(v.data.scenes, v.data.durationLabel)}
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    )
  }

  <div class="section-title"><span class="bar"></span> 전체 영상</div>

  <div class="pc-chips" id="pc-chips">
    <button class="pc-chip is-active" data-cat="__all">전체</button>
    {cats.map((c) => <button class="pc-chip" data-cat={c}>{c}</button>)}
  </div>

  <div class="pc-grid" id="pc-grid">
    {
      videos.map((v) => (
        <div class="grid-item" data-cat={v.data.category} data-title={v.data.title.toLowerCase()}>
          <VideoCard video={v} />
        </div>
      ))
    }
  </div>

  <p id="pc-empty" style="display:none;text-align:center;color:var(--text-muted);padding:3rem">
    검색 결과가 없어요.
  </p>

  <script is:inline slot="tail">
    (function () {
      var chips = document.getElementById('pc-chips');
      var grid = document.getElementById('pc-grid');
      var empty = document.getElementById('pc-empty');
      var search = document.getElementById('pc-search-input');
      var cat = '__all';
      var q = '';
      function apply() {
        var shown = 0;
        grid.querySelectorAll('.grid-item').forEach(function (el) {
          var okCat = cat === '__all' || el.dataset.cat === cat;
          var okQ = !q || el.dataset.title.indexOf(q) !== -1;
          var vis = okCat && okQ;
          el.style.display = vis ? '' : 'none';
          if (vis) shown++;
        });
        empty.style.display = shown ? 'none' : 'block';
      }
      if (chips)
        chips.addEventListener('click', function (e) {
          var b = e.target.closest('.pc-chip');
          if (!b) return;
          chips.querySelectorAll('.pc-chip').forEach(function (c) {
            c.classList.remove('is-active');
          });
          b.classList.add('is-active');
          cat = b.dataset.cat;
          apply();
        });
      if (search)
        search.addEventListener('input', function () {
          q = search.value.trim().toLowerCase();
          apply();
        });
    })();
  </script>
</BaseLayout>
