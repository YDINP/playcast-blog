---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HostRig from '../components/HostRig.astro';
import VideoCard from '../components/VideoCard.astro';
import { watchHref, durationLabel, posterOf, timeAgo } from '../lib/video';

const videos = (await getCollection('videos', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.pubDate - +a.data.pubDate
);

// 홈 히어로 = 로지가 서 있는 스튜디오 + 최신 영상 썸네일 목록.
// 예전엔 최신 한 편을 자동재생했고, 그 다음엔 추천작을 훑는 리엘을 틀었다. 둘 다 "보고 있어야
// 다음 정보가 나오는" 구조라, 처음 온 방문자가 어떤 편들이 있는지 한눈에 못 봤다.
// 지금은 재생을 기다릴 필요 없이 목록이 즉시 다 보이고, 썸네일을 누르면 그 편으로 바로 간다.
const PICK_MAX = 6;
const curated = videos
  .filter((v) => typeof v.data.pick === 'number')
  .sort((a, b) => (a.data.pick as number) - (b.data.pick as number));
// 기본은 최신순. pick을 지정한 글이 있으면 그 순서가 우선한다(큐레이션 훅).
const picks = (curated.length ? curated : videos).slice(0, PICK_MAX);

// 카드 라벨 — 긴 제목을 게임명 수준으로 줄인다. 카드가 작아서 전체 제목은 들어가지 않고,
// 두 줄 넘게 흐르면 떠 있는 카드들이 서로 다른 높이로 흔들려 지저분해진다.
// 규칙: ①"게임명 — 설명" 규격이면 앞부분 ②그래도 길면 따옴표로 감싼 고유명 ③최후에 절단.
const MAX_LABEL = 24;
const QUOTE_PAIRS: Record<string, string> = { "'": "'", '"': '"', '「': '」', '『': '』', '‘': '’', '“': '”' };
function cardTitle(t: string): string {
  let head = t.split(/\s[—–]\s/)[0].trim();
  const q = t.match(/['"「『‘“]([^'"」』’”]{2,22})['"」』’”]/);
  if (head.length > MAX_LABEL) {
    if (q && q[1].length <= MAX_LABEL) head = q[1];
    else head = head.split(/[!?·,]/)[0].trim();
  }
  const close = QUOTE_PAIRS[head[0]];
  if (close && head.endsWith(close) && head.length > 2) head = head.slice(1, -1).trim();
  return head.length > MAX_LABEL ? head.slice(0, MAX_LABEL - 1).trimEnd() + '…' : head;
}

const cats = Array.from(new Set(videos.map((v) => v.data.category)));

// 채널 홈 = 영상 목록. ItemList로 검색엔진에 콘텐츠 리스트 구조 전달
const site = Astro.site || new URL('https://virtual-in-playing.vercel.app');
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '추천 게임 소개 영상',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: picks.length,
  itemListElement: picks.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(watchHref(v.id), site).href,
    name: v.data.title,
  })),
};
---

<BaseLayout
  title="Virtual in Playing (VIP) — 게임 소개 방송 채널"
  description="버츄얼 호스트 로지가 게임·최신 신작·버추얼 아이돌/스트리머를 영상처럼 소개하는 채널. 무료 게임·인디 명작부터 버튜버 입문까지, 자막 영상으로 편하게."
  schemas={[itemListSchema]}
>
  {
    picks.length > 0 && (
      <section class="pc-studio">
        <div class="studio-head">
          <div class="hero-kicker">▶ 로지의 추천</div>
          <h2 class="studio-title">지금 볼 만한 영상</h2>
          <p class="studio-sub">카드를 누르면 바로 시청 페이지로 이동합니다.</p>
        </div>

        <div class="studio-stage">
          <div class="studio-rig" aria-hidden="true">
            <HostRig />
          </div>

          <ul class="float-cards">
            {picks.map((v, i) => {
              const poster = posterOf(v.data);
              return (
                <li class="fc-item" style={`--i:${i}`}>
                  <a href={watchHref(v.id)} class="fc-card">
                    <span class="fc-thumb">
                      {poster && <img src={poster} alt="" loading="lazy" />}
                      <span class="fc-dur">
                        {durationLabel(v.data.scenes, v.data.durationLabel)}
                      </span>
                    </span>
                    <span class="fc-body">
                      <span class="fc-title">{cardTitle(v.data.title)}</span>
                      <span class="fc-meta">
                        {v.data.category} · {timeAgo(v.data.pubDate)}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <div class="section-title"><span class="bar"></span> 전체 영상</div>

  <div class="pc-chips" id="pc-chips">
    <button class="pc-chip is-active" data-cat="__all">전체</button>
    {cats.map((c) => <button class="pc-chip" data-cat={c}>{c}</button>)}
  </div>

  <div class="pc-grid" id="pc-grid">
    {
      videos.map((v) => (
        <div class="grid-item" data-cat={v.data.category} data-title={v.data.title.toLowerCase()}>
          <VideoCard video={v} />
        </div>
      ))
    }
  </div>

  <p id="pc-empty" style="display:none;text-align:center;color:var(--text-muted);padding:3rem">
    검색 결과가 없어요.
  </p>

  <script is:inline slot="tail">
    (function () {
      var chips = document.getElementById('pc-chips');
      var grid = document.getElementById('pc-grid');
      var empty = document.getElementById('pc-empty');
      var search = document.getElementById('pc-search-input');
      var cat = '__all';
      var q = '';
      function apply() {
        var shown = 0;
        grid.querySelectorAll('.grid-item').forEach(function (el) {
          var okCat = cat === '__all' || el.dataset.cat === cat;
          var okQ = !q || el.dataset.title.indexOf(q) !== -1;
          var vis = okCat && okQ;
          el.style.display = vis ? '' : 'none';
          if (vis) shown++;
        });
        empty.style.display = shown ? 'none' : 'block';
      }
      if (chips)
        chips.addEventListener('click', function (e) {
          var b = e.target.closest('.pc-chip');
          if (!b) return;
          chips.querySelectorAll('.pc-chip').forEach(function (c) {
            c.classList.remove('is-active');
          });
          b.classList.add('is-active');
          cat = b.dataset.cat;
          apply();
        });
      if (search)
        search.addEventListener('input', function () {
          q = search.value.trim().toLowerCase();
          apply();
        });
    })();
  </script>
</BaseLayout>
