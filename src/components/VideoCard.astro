---
import HostMascot from './HostMascot.astro';
import {
  durationLabel,
  formatViews,
  timeAgo,
  watchHref,
  posterOf,
  baseCategory,
  displayCategory,
  kstDay,
} from '../lib/video';
import type { CollectionEntry } from 'astro:content';
import hostSide from '../data/host-side.json';

interface Props {
  video: CollectionEntry<'videos'>;
  variant?: 'grid' | 'side';
}
const { video, variant = 'grid' } = Astro.props;
const { data } = video;
const poster = posterOf(data);
const dur = durationLabel(data.scenes, data.durationLabel);
const href = watchHref(video.id);

// 썸네일에 얹는 미니 호스트 — video.id 시드로 표정/크기/좌우반전을 결정론적 랜덤화.
// 표정은 char2 풀 이미지 7종에서 시드 선택(카드마다 다르게).
// 배치 쪽(side)은 썸네일별 하단 코너 복잡도 분석(host-side.json)으로 빈 쪽에 놓아
// 포스터의 캐릭터·타이틀 로고를 최대한 피한다.
function seeded(str: string) {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return () => {
    h += 0x6d2b79f5;
    let t = h;
    t = Math.imul(t ^ (t >>> 15), 1 | t);
    t ^= t + Math.imul(t ^ (t >>> 7), 61 | t);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
// 카테고리 태그의 시효(New는 2일까지)는 lib/video.ts 가 SSOT — 홈 필터칩도 같은 함수를 쓴다.
const baseCat = baseCategory(data.category);
const pubDay = kstDay(data.pubDate);
const shownCat = displayCategory(data.category, data.pubDate);

const rnd = seeded(video.id);
const rojiExprs = ['base', 'mouth-a', 'mouth-e', 'mouth-i']; // 기본 얼굴 + 입모양만 변화(표정 X)
const rojiExpr = rojiExprs[Math.floor(rnd() * rojiExprs.length)];
// 빈 하단 코너(캐릭터·로고 회피). 맵에 없으면 시드 폴백.
const rojiSide = (hostSide as Record<string, string>)[poster ?? ''] ?? (rnd() < 0.5 ? 'left' : 'right');
const rojiOff = (rnd() * 3).toFixed(1); // 가장자리 0~3%
const rojiH = (46 + rnd() * 12).toFixed(0); // 높이 46~58% (컴팩트)
const rojiFlip = rojiSide === 'right'; // 오른쪽이면 반전 → 항상 화면 안쪽을 향함
const rojiStyle = `${rojiSide}:${rojiOff}%;height:${rojiH}%;${rojiFlip ? 'transform:scaleX(-1);' : ''}`;
---

{
  variant === 'grid' ? (
    <a
      href={href}
      class="vcard"
      data-cat={shownCat.toLowerCase()}
      data-pub={pubDay}
      data-cat-base={baseCat}
    >
      {/* 카테고리 태그는 썸네일 '바깥 위쪽'에 둔다 — 안에 얹으면 포스터 주제부를 가린다.
          "새 글" 신호는 썸네일 테두리 글로우(data-cat 색)가 대신 준다.
          라벨은 접속 날짜 기준으로 BaseLayout 인라인 스크립트가 New↔코너를 보정한다. */}
      <span class="vcard-cat">{shownCat}</span>
      <div class:list={['vcard-thumb', { 'is-empty': !poster }]}>
        <div class="sp-bg is-grad is-on" style="position:absolute;inset:0"></div>
        {poster && <img src={poster} alt={data.title} loading="lazy" onerror="this.style.display='none'" />}
        {!data.customThumb && (
          <span class="card-roji" style={rojiStyle} aria-hidden="true">
            <img class="roji-base" src={`/host/roji/${rojiExpr}.png`} alt="" loading="lazy" />
          </span>
        )}
        <span class="vcard-dur">{dur}</span>
        <span class="vcard-play">
          <span>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="#fff">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
        </span>
      </div>
      <div class="vcard-meta">
        <span class="vcard-ava">
          <HostMascot variant="avatar" />
        </span>
        <div class="vcard-info">
          <h3>{data.title}</h3>
          <div class="sub">
            <div class="ch">로지 · VIP</div>
            <div>
              <span class="vw-n" data-vw-slug={video.id} data-vw-seed={data.views}>{formatViews(data.views)}</span> · {timeAgo(data.pubDate)}
            </div>
          </div>
          {/* 리스트 보기에서만 노출 — 카드 보기에선 제목 옆 여백이 없어 넣을 자리가 없다. */}
          <p class="vcard-desc">{data.hook ?? data.description}</p>
        </div>
      </div>
    </a>
  ) : (
    <a href={href} class="side-card">
      <div class="vcard-thumb">
        <div class="sp-bg is-grad is-on" style="position:absolute;inset:0"></div>
        {poster && <img src={poster} alt={data.title} loading="lazy" onerror="this.style.display='none'" />}
        <span class="vcard-dur">{dur}</span>
      </div>
      <div>
        <h3>{data.title}</h3>
        <div class="sub">로지 · VIP</div>
        <div class="sub">
          {formatViews(data.views)} · {timeAgo(data.pubDate)}
        </div>
      </div>
    </a>
  )
}
